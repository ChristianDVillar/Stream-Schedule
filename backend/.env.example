# Backend Environment Variables
# Copy to .env and set values. Never commit .env or real secrets.

# --- Email (Resend) — transactional mail for licenses, payments, admin password reset, stream reminders ---
# https://resend.com — create API key, verify domain streamautomator.com
# EMAIL_ENABLED=false
# RESEND_API_KEY=re_xxxxxxxx
# Default From (StreamAutomator product). AkoeNet backend should use: AkoeNet <akonet@streamautomator.com> with the same API key.
# EMAIL_FROM=StreamAutomator <no-reply@streamautomator.com>

# Slack OAuth (Settings → Connect Slack)
# Create an app at https://api.slack.com/apps → OAuth & Permissions:
#   Redirect URL: https://YOUR_BACKEND_URL/api/user/auth/slack/link/callback
#   Bot Token Scopes: chat:write, channels:manage, users:read, usergroups:write, usergroups:read
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
# Optional: for verifying Slack Events API / slash commands (future use)
# SLACK_SIGNING_SECRET=your_signing_secret
# SLACK_VERIFICATION_TOKEN=your_verification_token

# Instagram Business (Graph API) — Settings → Platforms shows account + recent media when set
# Use a long-lived Page access token with permissions for the linked Facebook Page / IG user.
# INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
# INSTAGRAM_PAGE_ACCESS_TOKEN=your_page_access_token
# Optional: FACEBOOK_GRAPH_API_VERSION=v25.0
# Optional: comma-separated metrics for GET .../media/{id}/insights (default impressions,reach,engagement,saved)
# INSTAGRAM_INSIGHTS_METRICS=impressions,reach,engagement,saved

# AkoeNet — recommended global fallback when AkoeNet is your primary “community” (Discord replacement):
# users can pick server/channel without pasting URL/secret, as long as AkoeNet exposes GET …/integrations/scheduler/servers.
# Per-user URL in Settings → Bots → AkoeNet still overrides this (localhost, LAN, ngrok, etc.).
# Dev (Vite default): http://localhost:5173/integrations/scheduler/webhooks/stream-scheduled
# AKOENET_SCHEDULER_WEBHOOK_URL=https://your-akoenet-host.example.com/integrations/scheduler/webhooks/stream-scheduled
# Shared with AkoeNet (SCHEDULER_WEBHOOK_SECRET there must match byte-for-byte). On Render: paste one value; do not add extra wrapping quotes unless they are part of the secret. Special characters (&, =, %, `, #, double-quote, etc.) are OK.
# SCHEDULER_WEBHOOK_SECRET=shared_secret
# Optional: override target channel in the webhook payload (must match AkoeNet if used)
# SCHEDULER_ANNOUNCE_CHANNEL_ID=

# CORS: extra allowed browser Origins (comma-separated), e.g. AkoeNet frontend if it calls this API directly
# (Server-side proxy from AkoeNet backend does not need this.)
# INTEGRATION_CORS_ORIGINS=https://akonet.example.com,http://localhost:5173
