# Backend Environment Variables
# Copy to .env and set values. Never commit .env or real secrets.

# Slack OAuth (Settings → Connect Slack)
# Create an app at https://api.slack.com/apps → OAuth & Permissions:
#   Redirect URL: https://YOUR_BACKEND_URL/api/user/auth/slack/link/callback
#   Bot Token Scopes: chat:write, channels:manage, users:read, usergroups:write, usergroups:read
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
# Optional: for verifying Slack Events API / slash commands (future use)
# SLACK_SIGNING_SECRET=your_signing_secret
# SLACK_VERIFICATION_TOKEN=your_verification_token

# Instagram Business (Graph API) — Settings → Platforms shows account + recent media when set
# Use a long-lived Page access token with permissions for the linked Facebook Page / IG user.
# INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
# INSTAGRAM_PAGE_ACCESS_TOKEN=your_page_access_token
# Optional: FACEBOOK_GRAPH_API_VERSION=v25.0
# Optional: comma-separated metrics for GET .../media/{id}/insights (default impressions,reach,engagement,saved)
# INSTAGRAM_INSIGHTS_METRICS=impressions,reach,engagement,saved
