{
  "name": "streamer-scheduler",
  "private": true,
  "version": "2.3.1",
  "description": "Streamer Scheduler — apps/api (Express), apps/web (React)",
  "scripts": {
    "install:all": "npm install --prefix apps/api && npm install --prefix apps/web",
    "dev:api": "npm run dev --prefix apps/api",
    "dev:web": "npm start --prefix apps/web",
    "start:api": "npm start --prefix apps/api",
    "build:web": "npm run build --prefix apps/web",
    "test:api": "npm test --prefix apps/api",
    "test:web": "npm test --prefix apps/web"
  }
}
